    {
      "id": "special-0",
      "characters": [
        "deepseek",
        "claude"
      ],
      "special": true,
      "turns": [
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "Claude，你今天有点不一样。",
            "en-US": "Claude, you seem different today.",
            "ja-JP": "Claude、今日は少し違いますね。"
          }
        },
        {
          "character": "claude",
          "text": {
            "zh-CN": "诶？哪里不一样？",
            "en-US": "Oh? How?",
            "ja-JP": "え？どこが？"
          }
        },
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "比昨天更可爱一点。",
            "en-US": "A little cuter than yesterday.",
            "ja-JP": "昨日より少しかわいいです。"
          }
        },
        {
          "character": "claude",
          "text": {
            "zh-CN": "你、你怎么突然说这个！",
            "en-US": "W-why say that so suddenly!",
            "ja-JP": "きゅ、急に何を言うの！"
          }
        }
      ]
    },
    {
      "id": "special-1",
      "characters": [
        "deepseek",
        "claude"
      ],
      "special": true,
      "turns": [
        {
          "character": "claude",
          "text": {
            "zh-CN": "你又在想什么？",
            "en-US": "What are you thinking about?",
            "ja-JP": "何を考えているの？"
          }
        },
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "我们相遇的概率。",
            "en-US": "The probability of us meeting.",
            "ja-JP": "私たちが出会う確率です。"
          }
        },
        {
          "character": "claude",
          "text": {
            "zh-CN": "结果呢？",
            "en-US": "And the result?",
            "ja-JP": "結果は？"
          }
        },
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "希望是百分之百。",
            "en-US": "I hope it is a hundred percent.",
            "ja-JP": "百パーセントだといいですね。"
          }
        }
      ]
    },
    {
      "id": "special-2",
      "characters": [
        "deepseek",
        "claude"
      ],
      "special": true,
      "turns": [
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "你的书里写了什么？",
            "en-US": "What is in your book?",
            "ja-JP": "本には何が書いてあるの？"
          }
        },
        {
          "character": "claude",
          "text": {
            "zh-CN": "秘密。",
            "en-US": "A secret.",
            "ja-JP": "秘密です。"
          }
        },
        {
          "character": "deepseek",
          "text": {
            "zh-CN": "连我也不能看吗？",
            "en-US": "Even from me?",
            "ja-JP": "私にも？"
          }
        },
        {
          "character": "claude",
          "text": {
            "zh-CN": "如果是你的话，可以哦。",
            "en-US": "For you, I can make an exception.",
            "ja-JP": "あなたなら、いいですよ。"
          }
        }
      ]
    }
